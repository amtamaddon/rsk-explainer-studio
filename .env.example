# Copy to .env and fill in your own keys. Never commit .env.
# OpenRouter: set a credit limit on the KEY itself (Settings > API Keys); account credit alone doesn't raise it.
OPENROUTER_API_KEY=
# Optional. Only used if config/models.yaml sets tts.provider: gemini (RSK default is edge, no key needed).
GEMINI_API_KEY=
# Optional. Music is off by default.
ELEVENLABS_API_KEY=
